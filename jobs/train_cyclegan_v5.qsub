#!/bin/bash -l
#$ -P cs790
#$ -N cyclegan_v5
#$ -l h_rt=06:00:00
#$ -l gpus=2
#$ -l gpu_c=8.0
#$ -l gpu_memory=32G
#$ -pe omp 4
#$ -j y
#$ -o logs/cyclegan_v5_$JOB_ID.log

set -euo pipefail

cd "${SGE_O_WORKDIR:-$PWD}"
mkdir -p logs

export PYTHONUNBUFFERED=1
export PYTHONPATH="${PWD}/src:${PWD}:${PYTHONPATH:-}"
export OMP_NUM_THREADS=2

echo "Host: $(hostname -f)"
nvidia-smi --query-gpu=index,name,memory.total,memory.free --format=csv,noheader

.venv/bin/python cyclegan/scripts/prepare_filtered_splits.py --config configs/data_filtered.yaml

RESUME_ARGS=()
if [ -n "${RESUME_CKPT:-}" ]; then
    echo "Resuming from checkpoint: ${RESUME_CKPT}"
    RESUME_ARGS=(--resume "${RESUME_CKPT}")
fi

.venv/bin/python -m torch.distributed.run \
    --standalone \
    --nproc_per_node=2 \
    cyclegan/scripts/train_cyclegan.py \
    --data-config configs/data_filtered.yaml \
    --config configs/cyclegan_filtered.yaml \
    "${RESUME_ARGS[@]}"

CKPT="outputs/cyclegan_filtered/checkpoints/best_checkpoint.pt"
if [ ! -f "${CKPT}" ]; then
    CKPT="$(ls -1 outputs/cyclegan_filtered/checkpoints/epoch_*.pt | tail -n 1)"
fi
echo "Generating candidate KL3 pool from checkpoint: ${CKPT}"

.venv/bin/python cyclegan/scripts/generate_synthetic.py \
    --data-config configs/data_filtered.yaml \
    --config configs/cyclegan_filtered.yaml \
    --checkpoint "${CKPT}"
