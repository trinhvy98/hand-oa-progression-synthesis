#!/bin/bash -l
#$ -P cs790
#$ -N eval_m5_kl34
#$ -l h_rt=01:00:00
#$ -l gpus=1
#$ -l gpu_c=8.0
#$ -l gpu_memory=24G
#$ -pe omp 4
#$ -j y
#$ -o logs/eval_m5_kl34_$JOB_ID.log

set -euo pipefail

cd "${SGE_O_WORKDIR:-$PWD}"
mkdir -p logs

export PYTHONUNBUFFERED=1
export PYTHONPATH="${PWD}/src:${PWD}:${PYTHONPATH:-}"

echo "Host: $(hostname -f)"
nvidia-smi --query-gpu=name,memory.total,memory.free --format=csv,noheader

ORACLE_CKPT="outputs/evaluation_v6/oracle_os_focal.pt"
SYN_KL3="outputs/cyclegan_v6/synthetic_kl3/synthetic_manifest_filtered.csv"
RAW_KL4="outputs/cyclegan_v6_kl4/synthetic_kl4/synthetic_manifest.csv"
FILT_KL4="outputs/cyclegan_v6_kl4/synthetic_kl4/synthetic_manifest_filtered.csv"
COMBINED_SYN="outputs/cyclegan_v6_kl4/synthetic_kl34_combined.csv"
OUT_DIR="outputs/evaluation_v6_kl34"

echo "=== Step 1: Pure-KL4 Expert Filter 2 Screening ==="
.venv/bin/python cyclegan/scripts/filter_synthetic_kl3.py \
    --data-config configs/data_filtered.yaml \
    --cyclegan-config configs/cyclegan_kl4.yaml \
    --classifier-config configs/classifier_filtered.yaml \
    --synthetic-manifest "${RAW_KL4}" \
    --oracle-checkpoint "${ORACLE_CKPT}" \
    --output-manifest "${FILT_KL4}" \
    --target-kl 4 \
    --max-bg-diff 2.0 \
    --min-ssim 0.62 \
    --max-ssim 0.96 \
    --min-delta-l1 0.035 \
    --min-joint-focus 0.70 \
    --min-lap-ratio 0.70 \
    --min-kl3-prob 0.50 \
    --min-kl3-margin 0.15 \
    --require-kl3-argmax \
    --min-keep 20 \
    --max-accepted 150

echo "=== Step 2: Combine Pure-KL3 (200) + Pure-KL4 Manifests ==="
.venv/bin/python -c "
import pandas as pd
df3 = pd.read_csv('${SYN_KL3}')
df4 = pd.read_csv('${FILT_KL4}')
comb = pd.concat([df3, df4], ignore_index=True)
comb.to_csv('${COMBINED_SYN}', index=False)
print('Combined synthetic counts:', comb['target_kl'].value_counts().sort_index().to_dict())
"

echo "=== Step 3: Model 5 ConvNeXt-Tiny with Pure KL3 + Pure KL4 Synthetic Augmentation, Seed 42 ==="
.venv/bin/python evaluation/run_downstream_eval.py \
    --data-config configs/data_filtered.yaml \
    --config configs/classifier_filtered.yaml \
    --output-dir "${OUT_DIR}" \
    --tag model5_v6_kl34_cnxt_sd_os_focal \
    --backbone convnext_tiny \
    --optimizer adamw \
    --loss-type focal \
    --focal-gamma 2.0 \
    --class-weights 1.0 1.0 1.0 1.6 1.85 \
    --synthetic-manifest "${COMBINED_SYN}" \
    --oversample-kl3 4 \
    --oversample-kl4 5 \
    --batch-size 32 \
    --lr 0.000035 \
    --weight-decay 0.005 \
    --scale-jitter 0.04 \
    --brightness-jitter 0.08 \
    --contrast-jitter 0.08 \
    --scheduler cosine \
    --min-lr 0.000001 \
    --epochs 45 \
    --patience 20 \
    --min-best-epoch 8 \
    --selection-metric oa_balanced \
    --seed 42 \
    --seed-tagged \
    --fast-gpu-loader \
    --save-checkpoint "${OUT_DIR}/model5_v6_kl34_cnxt_seed42.pt"
