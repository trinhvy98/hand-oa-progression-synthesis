#!/bin/bash -l
#$ -P cs790
#$ -N cal_v5_dn
#$ -l h_rt=00:15:00
#$ -l gpus=1
#$ -l gpu_c=8.0
#$ -l gpu_memory=16G
#$ -pe omp 4
#$ -j y
#$ -o logs/cal_v5_dn_$JOB_ID.log

set -euo pipefail

cd "${SGE_O_WORKDIR:-$PWD}"
mkdir -p logs

export PYTHONUNBUFFERED=1
export PYTHONPATH="${PWD}/src:${PWD}:${PYTHONPATH:-}"

echo "Host: $(hostname -f)"
nvidia-smi --query-gpu=name,memory.total,memory.free --format=csv,noheader

.venv/bin/python evaluation/calibrate_checkpoint.py \
    --data-config configs/data_filtered_v2.yaml \
    --config configs/classifier_filtered.yaml \
    --checkpoint outputs/evaluation_model5_v5_clean/model5_v5_clean_dn121_mt_seed42.pt \
    --backbone densenet121 \
    --hierarchical-oa \
    --output-json outputs/evaluation_model5_v5_clean/model5_v5_clean_dn121_mt_seed42_calibrated_metrics.json
