#!/bin/bash -l
#$ -P cs790
#$ -N eval_m5_p12
#$ -l h_rt=02:00:00
#$ -l gpus=1
#$ -l gpu_c=8.0
#$ -l gpu_memory=24G
#$ -pe omp 4
#$ -j y
#$ -o logs/eval_m5_p12_$JOB_ID.log

set -euo pipefail

cd "${SGE_O_WORKDIR:-$PWD}"
mkdir -p logs

export PYTHONUNBUFFERED=1
export PYTHONPATH="${PWD}/src:${PWD}:${PYTHONPATH:-}"

echo "Host: $(hostname -f)"
nvidia-smi --query-gpu=name,memory.total,memory.free --format=csv,noheader

CG_CKPT="outputs/cyclegan_filtered/checkpoints/best_checkpoint.pt"
SYN_DIR="outputs/cyclegan_filtered/synthetic_kl3"
RAW_SYN="${SYN_DIR}/synthetic_manifest.csv"
FILT_SYN="${SYN_DIR}/synthetic_manifest_filtered.csv"
ORACLE_CKPT="outputs/evaluation_v5/oracle_os_focal.pt"
OUT_DIR="outputs/evaluation_v5_p12"

echo "=== Step 1 (Proposal 1a): Regenerate 1,500 CycleGAN KL3 Candidates from Ep 90 Checkpoint ==="
rm -rf "${SYN_DIR}/images"
mkdir -p "${SYN_DIR}/images"
.venv/bin/python cyclegan/scripts/generate_synthetic.py \
    --data-config configs/data_filtered.yaml \
    --config configs/cyclegan_filtered.yaml \
    --checkpoint "${CG_CKPT}" \
    --max-samples 1500 \
    --output-dir "${SYN_DIR}"

echo "=== Step 2 (Proposal 1b): Pure-KL3 Expert Filter 2 Screening ==="
.venv/bin/python cyclegan/scripts/filter_synthetic_kl3.py \
    --data-config configs/data_filtered.yaml \
    --cyclegan-config configs/cyclegan_filtered.yaml \
    --classifier-config configs/classifier_filtered.yaml \
    --synthetic-manifest "${RAW_SYN}" \
    --oracle-checkpoint "${ORACLE_CKPT}" \
    --output-manifest "${FILT_SYN}" \
    --min-joint-focus 0.75 \
    --min-kl3-prob 0.45 \
    --max-kl4-prob 0.30 \
    --min-kl3-margin 0.10 \
    --require-kl3-argmax

echo "=== Step 3 (Proposal 2): Model 5 Only (Filter 1 + Pure-KL3 Filter 2 + OS + Focal + Plateau), Seed 42 ==="
.venv/bin/python evaluation/run_downstream_eval.py \
    --data-config configs/data_filtered.yaml \
    --config configs/classifier_filtered.yaml \
    --output-dir "${OUT_DIR}" \
    --tag model5_p12_sd_os_focal \
    --loss-type focal \
    --focal-gamma 2.0 \
    --class-weights 1.0 1.0 1.0 2.1 2.0 \
    --synthetic-manifest "${FILT_SYN}" \
    --oversample-kl3 3 \
    --oversample-kl4 10 \
    --batch-size 32 \
    --lr 0.00003 \
    --scheduler plateau \
    --lr-factor 0.5 \
    --lr-patience 5 \
    --min-lr 0.000001 \
    --epochs 100 \
    --patience 20 \
    --min-best-epoch 12 \
    --selection-metric val_balanced_loss \
    --seed 42 \
    --seed-tagged \
    --fast-gpu-loader \
    --save-checkpoint "${OUT_DIR}/model5_p12_seed42.pt"
