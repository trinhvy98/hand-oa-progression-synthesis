#!/bin/bash -l
#$ -P cs790
#$ -N eval_v8_ens
#$ -l h_rt=00:15:00
#$ -l gpus=1
#$ -l gpu_c=8.0
#$ -l gpu_memory=24G
#$ -pe omp 4
#$ -j y
#$ -o logs/eval_v8_ens_$JOB_ID.log

set -euo pipefail

cd "${SGE_O_WORKDIR:-$PWD}"
mkdir -p logs

export PYTHONUNBUFFERED=1
export PYTHONPATH="${PWD}/src:${PWD}:${PYTHONPATH:-}"

echo "=== 1. Strictly KL-Only Val-Selected Ensemble ==="
.venv/bin/python evaluation/eval_ensemble.py \
    --hierarchical-oa \
    --models \
        densenet121:outputs/evaluation_v8_densenet/model5_v8_dn121_seed42.pt \
        convnext_tiny:outputs/evaluation_v6_convnext/model5_v6_convnext_seed42.pt \
        vgg19_sp:outputs/evaluation_v6_sp/model5_v6_sp_seed42.pt \
        efficientnet_v2_s:outputs/evaluation_v8_effv2/model5_v8_effv2_seed42.pt

echo "=== 2. Full (KL + Aux OARSI) Val-Selected Ensemble ==="
.venv/bin/python evaluation/eval_ensemble.py \
    --hierarchical-oa \
    --models \
        densenet121:outputs/evaluation_v9_dn_mt/model5_v9_dn121_mt_seed42.pt \
        convnext_tiny:outputs/evaluation_v6_convnext/model5_v6_convnext_seed42.pt \
        vgg19_sp:outputs/evaluation_v6_sp/model5_v6_sp_seed42.pt \
        convnext_tiny:outputs/evaluation_v7_multitask/model5_v7_mt_seed42.pt
